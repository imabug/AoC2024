{
    "name": "imabug/AoC2024",
    "description": "Code for Advent of Code 2024",
    "keywords": [""],
    "homepage": "",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Eugene Mah",
            "email": "eugenemah@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2.0",
        "graphp/graph": "^1@dev",
        "intonate/tinker-zero": "^1.2",
        "laravel-zero/framework": "^11.0.2"
    },
    "require-dev": {
        "laravel/pint": "^1.18.1",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^3.5.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": ["aoc2024"]
}
